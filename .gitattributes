# Normalize project-authored text while preserving the original UCI files.
* text=auto eol=lf

# Raw data must remain byte-for-byte identical to the source distribution.
dataset/*.csv -text -diff
dataset/Readme.txt -text -diff

# Binary deliverables and screenshots.
*.pdf binary
*.png binary

# Third-party SBC template files are kept unmodified.
*.sty -diff
*.bst -diff
paper/reference-template.tex -diff
